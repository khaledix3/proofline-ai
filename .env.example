# Placeholder templates only. Never put real credentials in this tracked file.
# Development: put DATABASE_URL in .env.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/proofline_dev

# Automated tests: put TEST_DATABASE_URL in .env.test (not in .env).
TEST_DATABASE_URL=postgresql+psycopg://YOUR_TEST_USER:YOUR_URL_ENCODED_TEST_PASSWORD@127.0.0.1:5432/proofline_test

# Non-secret default for orders.v2; runtime overrides are saved per run.
LATENESS_THRESHOLD_SECONDS=300
